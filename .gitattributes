# Always store LF in the repo and convert per platform on checkout. Without
# this, autocrlf on Windows rewrites the line endings of text files such as
# geojson, and the Linux CI then checks out yet another set of bytes.
* text=auto eol=lf

# Binary, never touch
*.parquet binary
*.wasm    binary
*.woff2   binary
*.png     binary
*.jpg     binary

# geojson is text but huge; marked no-diff so git log does not flood the screen
*.geojson -diff
